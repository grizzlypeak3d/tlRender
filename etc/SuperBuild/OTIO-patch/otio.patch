diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4ef85c4..6f48689 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -26,8 +26,22 @@ set(CMAKE_OSX_DEPLOYMENT_TARGET "10.15" CACHE STRING "Minimum OS X deployment ve
 
 project(OpenTimelineIO VERSION ${OTIO_VERSION} LANGUAGES C CXX)
 
-set(CMAKE_CXX_VISIBILITY_PRESET hidden)
-set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
+# Hidden unless the caller has said otherwise. The types OTIO hands out
+# are cast by type on this side -- a media reference, a metadata entry --
+# and a hidden build gives a consumer a second copy of the type info of
+# whatever it does not mark, in a shared build and a static one alike:
+#
+#     type mismatch while decoding
+#     bad any cast
+#
+# so a build meant to be linked against asks for default visibility, and
+# one built for the Python modules keeps this.
+if(NOT DEFINED CMAKE_CXX_VISIBILITY_PRESET)
+    set(CMAKE_CXX_VISIBILITY_PRESET hidden)
+endif()
+if(NOT DEFINED CMAKE_VISIBILITY_INLINES_HIDDEN)
+    set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
+endif()
 
 #------------------------------------------------------------------------------
 # Options
@@ -194,12 +208,20 @@ else()
     message(STATUS "Building C++ with Coverage: OFF")
 endif()
 
-if(WIN32)
-    # Windows debug builds for Python require a d in order for the module to
-    # load. This also helps ensure that debug builds in general are matched
-    # to the Microsoft debug CRT.
-    set(OTIO_DEBUG_POSTFIX "_d")
-endif()
+# No debug postfix, where upstream sets "_d" on Windows. That is for a debug
+# interpreter, which looks for _opentime_d.pyd and nothing else, and there is
+# no debug interpreter here: pybind11 undefines _DEBUG around Python.h, so a
+# module is compiled against the release ABI in every configuration, and the
+# continuous integration runners ship no python_d.exe to load it with either.
+# The postfix only hides the module from the release interpreter that does
+# run the tests:
+#
+#     ModuleNotFoundError: No module named 'opentimelineio._opentime'
+#
+# The C++ libraries lose the postfix with it, which costs nothing. Debug and
+# Release install to separate prefixes, so the names do not meet, and both
+# tlRender and OTIO's own Python package reach these through the exported
+# OTIO::opentimelineio target rather than by file name.
 
 set_property(GLOBAL PROPERTY USE_FOLDERS ON)
 
diff --git a/src/opentime/export.h b/src/opentime/export.h
index 0d937a4..f7d495b 100644
--- a/src/opentime/export.h
+++ b/src/opentime/export.h
@@ -44,7 +44,12 @@
 
 #if defined(OPENTIME_STATIC)
 #    define OPENTIME_API
-#    define OPENTIME_API_TYPE
+// The type stays visible even in a static build: its type info is what a
+// consumer's std::any casts and dynamic_casts are resolved by, and a build
+// that hides its symbols would otherwise give the consumer a second copy of
+// it. The attribute marks the type alone, not its members, so nothing is
+// exported that a static library would not have exported anyway.
+#    define OPENTIME_API_TYPE OPENTIMELINEIO_EXPORT_TYPE
 #    define OPENTIME_API_TEMPLATE_CLASS(...)
 #    define OPENTIME_API_TEMPLATE_STRUCT(...)
 #    define OPENTIME_LOCAL
