diff --git a/CMakeLists.txt b/CMakeLists.txt
index ea11696..41dc22b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -191,12 +191,20 @@ else()
     message(STATUS "Building C++ with Coverage: OFF")
 endif()
 
-if(WIN32)
-    # Windows debug builds for Python require a d in order for the module to
-    # load. This also helps ensure that debug builds in general are matched
-    # to the Microsoft debug CRT.
-    set(OTIO_DEBUG_POSTFIX "_d")
-endif()
+# No debug postfix, where upstream sets "_d" on Windows. That is for a debug
+# interpreter, which looks for _opentime_d.pyd and nothing else, and there is
+# no debug interpreter here: pybind11 undefines _DEBUG around Python.h, so a
+# module is compiled against the release ABI in every configuration, and the
+# continuous integration runners ship no python_d.exe to load it with either.
+# The postfix only hides the module from the release interpreter that does
+# run the tests:
+#
+#     ModuleNotFoundError: No module named 'opentimelineio._opentime'
+#
+# The C++ libraries lose the postfix with it, which costs nothing. Debug and
+# Release install to separate prefixes, so the names do not meet, and both
+# tlRender and OTIO's own Python package reach these through the exported
+# OTIO::opentimelineio target rather than by file name.
 
 set_property(GLOBAL PROPERTY USE_FOLDERS ON)
 
@@ -295,6 +303,25 @@ endif()
 # set up the internally hosted dependencies
 add_subdirectory(src/deps)
 
+# minizip-ng names its target for how it was built: with the compatibility
+# layer it is MINIZIP::minizip, and without it MINIZIP::minizip-ng. Only an
+# installed one found by find_package can be missing the compatibility name --
+# the copy in src/deps aliases it either way -- but that is the configuration
+# find_package can actually resolve, so probe rather than assume. The probe has
+# to come after src/deps, which is where that target is defined.
+if(TARGET MINIZIP::minizip-ng)
+    set(OTIO_MINIZIP_TARGET MINIZIP::minizip-ng)
+else()
+    set(OTIO_MINIZIP_TARGET MINIZIP::minizip)
+endif()
+
+# Installing the bundled copy needs the library itself: install(TARGETS) does
+# not accept an alias.
+get_target_property(OTIO_MINIZIP_LIB ${OTIO_MINIZIP_TARGET} ALIASED_TARGET)
+if(NOT OTIO_MINIZIP_LIB)
+    set(OTIO_MINIZIP_LIB ${OTIO_MINIZIP_TARGET})
+endif()
+
 add_subdirectory(src/opentime)
 add_subdirectory(src/opentimelineio)
 
