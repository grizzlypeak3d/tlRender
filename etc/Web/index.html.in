<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>@tl_WEB_APP@</title>
<style>
html, body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #181818;
    /* Dragging in the canvas is the application's own selection, not
       the page's. */
    user-select: none;
    -webkit-user-select: none;
}
canvas { display: block; width: 100%; height: 100%; -webkit-user-drag: none; }
/* Errors are shown on the page: on a phone or a tablet there is no
   console to read, and the alternative is a silent black page. */
#error {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    max-height: 50%;
    overflow: auto;
    margin: 0;
    padding: 1em;
    background: #401818;
    color: #f0d0d0;
    font: 12px monospace;
    white-space: pre-wrap;
    user-select: text;
    -webkit-user-select: text;
}
</style>
</head>
<body>
<canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>
<pre id="error"></pre>
<!-- A host that cannot send the COOP/COEP headers, like GitHub
     Pages, gets them from a service worker that re-serves every
     response with the headers added; the first visit reloads once
     for the worker to take over. -->
<script src="coi-serviceworker.js"></script>
<script>
/* The page's own queries, which are not passed to the application:
   "mem" and "grow" for the wasm memory (see tlMakeMemory), "pool" for
   the number of thread workers, "wait=0" to start without waiting for
   them, and "reload=0" to stay put when the graphics context is lost,
   for reading what happened. */
var tlPageQueries = ['mem', 'grow', 'pool', 'wait', 'reload'];
var tlParams = new URLSearchParams(location.search);
/* Read by the runtime as its thread pool size (PTHREAD_POOL_SIZE). */
globalThis.__tlPoolSize = parseInt(tlParams.get('pool')) || 32;
function tlError(text) {
    var el = document.getElementById('error');
    el.style.display = 'block';
    el.textContent += text + '\n';
}
window.onerror = function(message, source, line, column, error) {
    tlError(message +
        (error && error.stack ? '\n' + error.stack : ''));
};
window.onunhandledrejection = function(event) {
    tlError(String(event.reason));
};
if (!crossOriginIsolated) {
    /* The coi service worker reloads the page once on its first
       visit; the error waits out that reload. */
    setTimeout(function() {
        if (!crossOriginIsolated) {
            tlError('The page is not cross-origin isolated; wasm ' +
                'threads need the COOP/COEP headers from the server.');
        }
    }, 3000);
}
/* The browser keeps the audio device suspended until a user gesture,
   and the resume has to happen inside the gesture's own handler. The
   application waits for the gesture before it starts playback, so the
   audio clock never runs against a suspended device. */
(function() {
    function gesture() {
        try {
            var sdl = Module['SDL2'];
            if (sdl && sdl.audioContext &&
                'suspended' === sdl.audioContext.state) {
                sdl.audioContext.resume();
            }
        } catch (e) {}
        globalThis.__tlGesture = 1;
    }
    ['click', 'keydown', 'touchstart'].forEach(function(type) {
        document.addEventListener(type, gesture, true);
    });
})();
/* The browser can take the graphics context away under memory
   pressure, and there is no getting every texture, shader and buffer
   back one by one: the page reloads instead, at the time the player
   had reached, playing if it was. The application reports its time
   through __tlTime. */
document.getElementById('canvas').addEventListener(
    'webglcontextlost',
    function() {
        if ('0' === tlParams.get('reload')) {
            tlError('The graphics context was lost.');
            return;
        }
        tlError('The graphics context was lost; reloading.');
        setTimeout(function() {
            var url = new URL(location.href);
            if (globalThis.__tlTime !== undefined) {
                url.searchParams.set('time', String(globalThis.__tlTime));
            }
            location.replace(url.toString());
        }, 1000);
    });
/* The wasm memory is made here rather than by the runtime, so that the
   most it may grow to can follow the device: Safari on an iPad refuses
   a shared memory with the 2GB maximum the build asks for, and refuses
   more with each reload of the page, so smaller maximums are tried
   until one is granted. A "mem" query names the maximum in MB, for a
   device where the first try is still too much, or for trying a small
   one.

   The memory starts at the build's size and grows; "grow=0" makes it
   at its full size instead, for trying that. Made at full size by
   default below 2GB (2026-11-16), Safari on an iPad refused it at every
   size after a reload, where a growing one is still granted. */
function tlMakeMemory() {
    var maximums = [2048, 1024, 512, 256];
    var params = new URLSearchParams(location.search);
    var query = params.get('mem');
    if (query) {
        maximums = [parseInt(query)];
    }
    var grow = params.get('grow');
    for (var i = 0; i < maximums.length; ++i) {
        var pages = maximums[i] * 16;
        var grows = '0' !== grow;
        try {
            var memory = new WebAssembly.Memory({
                initial: grows ? 256 : pages,
                maximum: pages,
                shared: true });
            /* Touching the buffer is what makes a refusal show here
               rather than later. */
            if (memory.buffer.byteLength > 0) {
                globalThis.__tlMemoryMax = maximums[i];
                console.log('Memory: ' + maximums[i] + 'MB maximum, ' +
                    (grows ? 'growing' : 'made at full size'));
                return memory;
            }
        } catch (e) {
            console.warn('A ' + maximums[i] + 'MB memory was refused: ' + e);
        }
    }
    /* The runtime makes its own, and reports the failure. */
    return undefined;
}
/* The query string is the command line: "?url=clip.mp4" becomes
   "-url clip.mp4". The page's own queries are left out. */
var tlArguments = (function() {
    var out = [];
    new URLSearchParams(location.search).forEach(function(value, key) {
        if (tlPageQueries.indexOf(key) >= 0) {
            return;
        }
        out.push('-' + key);
        if (value)
        {
            out.push(value);
        }
    });
    return out;
})();
/* The thread workers load in the background so that the page is not
   black while they do (PTHREAD_POOL_DELAY_LOAD), and main() waits for
   them: a thread the main thread waits on before its worker has loaded
   never starts, and the page hangs -- on a slower device, an iPad Pro
   10.5, at opening a file. "wait=0" starts at once, as before. */
var tlWait = '0' !== tlParams.get('wait');
var Module = {
    canvas: document.getElementById('canvas'),
    noInitialRun: tlWait,
    onRuntimeInitialized: function() {
        if (!tlWait) {
            return;
        }
        var t0 = performance.now();
        Promise.resolve(Module['pthreadPoolReady']).then(function() {
            console.log('Thread pool: ' + globalThis.__tlPoolSize +
                ' workers ready in ' +
                Math.round(performance.now() - t0) + ' ms');
            Module.callMain(tlArguments);
        });
    },
    wasmMemory: tlMakeMemory(),
    print: function(text) {
        console.log(text);
        if (/^(ERROR:|Unhandled exception)/.test(text)) {
            tlError(text);
        }
    },
    printErr: function(text) {
        console.error(text);
        tlError(text);
    },
    onAbort: function(what) {
        tlError('Aborted: ' + what);
    },
    /* The build id keeps the page and its binary together: a cached
       page fetches the .js and .wasm it was built with, not whatever a
       newer deployment left behind. */
    locateFile: function(path) {
        return path + '?v=@tl_WEB_ID@';
    },
    arguments: tlArguments
};
</script>

<script>
globalThis.__tlWCWorkerUrl = 'WebCodecsWorker.js?v=@tl_WEB_ID@';
</script>
<script src="mp4box.all.min.js?v=@tl_WEB_ID@"></script>
<script src="@tl_WEB_APP@.js?v=@tl_WEB_ID@"></script>
</body>
</html>
