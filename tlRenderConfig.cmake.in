@PACKAGE_INIT@

# \todo Is this the correct way to locate the custom Find*.cmake files?
list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})

include(CMakeFindDependencyMacro)

# The dependencies are installed with tlRender, by the super build and in a
# wheel, so they are looked for here first. This file runs in the caller's
# scope, so the search path is put back at the end.
set(_tlRender_PREFIX_PATH ${CMAKE_PREFIX_PATH})
list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")

# Base dependencies
find_package(Imath REQUIRED)
find_package(nlohmann_json REQUIRED)
find_package(ZLIB REQUIRED)
find_package(minizip-ng REQUIRED)
find_package(OpenTimelineIO REQUIRED)

# OpenColorIO dependencies
if(@TLRENDER_OCIO@)
    find_package(OpenColorIO REQUIRED)
    add_definitions(-DTLRENDER_OCIO)
endif()

# I/O dependencies
if(@TLRENDER_EXR@)
    find_package(OpenEXR)
    if(OpenEXR_FOUND)
        add_definitions(-DTLRENDER_EXR)
    endif()
endif()
if(@TLRENDER_FFMPEG@)
    if(WIN32)
        set(FFmpeg_FOUND TRUE)
        add_library(FFmpeg::avdevice STATIC IMPORTED)
        set_property(TARGET FFmpeg::avdevice PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/avdevice.lib")
        add_library(FFmpeg::avformat STATIC IMPORTED)
        set_property(TARGET FFmpeg::avformat PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/avformat.lib")
        add_library(FFmpeg::avcodec STATIC IMPORTED)
        set_property(TARGET FFmpeg::avcodec PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/avcodec.lib")
        add_library(FFmpeg::swresample STATIC IMPORTED)
        set_property(TARGET FFmpeg::swresample PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/swresample.lib")
        add_library(FFmpeg::swscale STATIC IMPORTED)
        set_property(TARGET FFmpeg::swscale PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/swscale.lib")
        add_library(FFmpeg::avutil STATIC IMPORTED)
        set_property(TARGET FFmpeg::avutil PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/avutil.lib")
        add_library(FFmpeg::FFmpeg INTERFACE IMPORTED)
        set_property(TARGET FFmpeg::FFmpeg PROPERTY
            INTERFACE_LINK_LIBRARIES
            FFmpeg::avdevice
            FFmpeg::avformat
            FFmpeg::avcodec
            FFmpeg::swresample
            FFmpeg::swscale
            FFmpeg::avutil)
    elseif(APPLE)
        set(FFmpeg_FOUND TRUE)
        add_library(FFmpeg::avdevice STATIC IMPORTED)
        set_property(TARGET FFmpeg::avdevice PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libavdevice.dylib")
        add_library(FFmpeg::avformat STATIC IMPORTED)
        set_property(TARGET FFmpeg::avformat PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libavformat.dylib")
        add_library(FFmpeg::avcodec STATIC IMPORTED)
        set_property(TARGET FFmpeg::avcodec PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libavcodec.dylib")
        add_library(FFmpeg::swresample STATIC IMPORTED)
        set_property(TARGET FFmpeg::swresample PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libswresample.dylib")
        add_library(FFmpeg::swscale STATIC IMPORTED)
        set_property(TARGET FFmpeg::swscale PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libswscale.dylib")
        add_library(FFmpeg::avutil STATIC IMPORTED)
        set_property(TARGET FFmpeg::avutil PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libavutil.dylib")
        add_library(FFmpeg::FFmpeg INTERFACE IMPORTED)
        set_property(TARGET FFmpeg::FFmpeg PROPERTY
            INTERFACE_LINK_LIBRARIES
            FFmpeg::avdevice
            FFmpeg::avformat
            FFmpeg::avcodec
            FFmpeg::swresample
            FFmpeg::swscale
            FFmpeg::avutil)
    elseif(EMSCRIPTEN)
        # Only the libraries Core uses: the I/O plugin is not built for
        # the web, and neither is the rest of FFmpeg.
        set(FFmpeg_FOUND TRUE)
        add_library(FFmpeg::avutil STATIC IMPORTED)
        set_property(TARGET FFmpeg::avutil PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libavutil.a")
        add_library(FFmpeg::swresample STATIC IMPORTED)
        set_property(TARGET FFmpeg::swresample PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libswresample.a")
        add_library(FFmpeg::swscale STATIC IMPORTED)
        set_property(TARGET FFmpeg::swscale PROPERTY
             IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libswscale.a")
    elseif(EXISTS "${PACKAGE_PREFIX_DIR}/lib/libavutil.so")
        # Installed beside tlRender, as in a wheel, which leaves out the
        # pkg-config files since they hold the build machine's paths.
        set(FFmpeg_FOUND TRUE)
        foreach(_tlRender_FFMPEG_LIB avdevice avformat avcodec swresample swscale avutil)
            add_library(FFmpeg::${_tlRender_FFMPEG_LIB} SHARED IMPORTED)
            set_property(TARGET FFmpeg::${_tlRender_FFMPEG_LIB} PROPERTY
                IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/lib${_tlRender_FFMPEG_LIB}.so")
        endforeach()
        add_library(FFmpeg::FFmpeg INTERFACE IMPORTED)
        set_property(TARGET FFmpeg::FFmpeg PROPERTY
            INTERFACE_LINK_LIBRARIES
            FFmpeg::avdevice
            FFmpeg::avformat
            FFmpeg::avcodec
            FFmpeg::swresample
            FFmpeg::swscale
            FFmpeg::avutil)
    else()
        find_package(PkgConfig REQUIRED)
        pkg_check_modules(
            swresample REQUIRED IMPORTED_TARGET
            libswresample)
        pkg_check_modules(
            swscale REQUIRED IMPORTED_TARGET
            libswscale)
        pkg_check_modules(
            avutil REQUIRED IMPORTED_TARGET
            libavutil)
        pkg_check_modules(
            FFmpeg REQUIRED IMPORTED_TARGET
            libavdevice
            libavformat
            libavcodec
            libswresample
            libswscale
            libavutil)
        add_library(FFmpeg::FFmpeg ALIAS PkgConfig::FFmpeg)
        add_library(FFmpeg::swresample ALIAS PkgConfig::swresample)
        add_library(FFmpeg::swscale ALIAS PkgConfig::swscale)
        add_library(FFmpeg::avutil ALIAS PkgConfig::avutil)
    endif()
    if(FFmpeg_FOUND)
        add_definitions(-DTLRENDER_FFMPEG)
        if(@TLRENDER_FFMPEG_PLUGIN@)
            add_definitions(-DTLRENDER_FFMPEG_PLUGIN)
        endif()
        if(@TLRENDER_FFMPEG_CMD@)
            add_definitions(-DTLRENDER_FFMPEG_CMD)
        endif()
    endif()
endif()
if(@TLRENDER_OIIO@)
    find_package(OpenImageIO)
    if(OpenImageIO_FOUND)
        add_definitions(-DTLRENDER_OIIO)
    endif()
endif()
if(@TLRENDER_USD@)
    find_package(pxr)
    if(pxr_FOUND)
        add_definitions(-DTLRENDER_USD)
    endif()
endif()

# feather-tk dependencies
find_package(ftk REQUIRED)

set(CMAKE_PREFIX_PATH ${_tlRender_PREFIX_PATH})
unset(_tlRender_PREFIX_PATH)

include("${CMAKE_CURRENT_LIST_DIR}/tlResourceTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/tlCoreTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/tlIOTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/tlTimelineTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/tlGLTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/tlUITargets.cmake")

# \todo Is this the correct way to add the include directory?
include_directories("@PACKAGE_INCLUDE_INSTALL_DIR@")

check_required_components(tlRender)
